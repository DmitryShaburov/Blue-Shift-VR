<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>BsvrInstaller</RootNamespace>
    <AssemblyName>bsvr-install</AssemblyName>
    <Version>0.1.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!--
    Everything under payload/ is embedded with a logical name that mirrors the
    mod folder layout, e.g. "payload/dlls/hl.dll" is installed to "<mod>/dlls/hl.dll".
    Files already tracked elsewhere in the repository are linked in rather than copied.
  -->
  <ItemGroup>
    <EmbeddedResource Include="payload\**" LogicalName="payload/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\network\delta.lst" LogicalName="payload/delta.lst" />
    <EmbeddedResource Include="..\LICENSE" LogicalName="payload/LICENSE" />
    <EmbeddedResource Include="..\THIRD_PARTY_LICENSES\**" LogicalName="payload/THIRD_PARTY_LICENSES/%(RecursiveDir)%(Filename)%(Extension)" />
    <!--
      The loader DLLs the client was linked against. client.dll imports them implicitly, so Windows looks
      for them next to hl.exe, not in cl_dlls\. "halflife/" resources are installed into the Half-Life folder.
    -->
    <EmbeddedResource Include="..\lib\public\openvr_api.dll" LogicalName="halflife/openvr_api.dll" />
    <EmbeddedResource Include="..\cl_dll\EasyHook\bin\EasyHook32.dll" LogicalName="halflife/EasyHook32.dll" />
  </ItemGroup>
</Project>
